---
import { getCollection, render } from 'astro:content';
import AcquisitionLayout from '../../layouts/AcquisitionLayout.astro';
import { getAcquisitionPaths } from '../../lib/acquisition.js';

export async function getStaticPaths() {
  const publishedEntries = (await getCollection('comparisons')).filter(
    (entry) => entry.data.status === 'published'
  );
  return publishedEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const COLLECTION = 'comparisons';
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `${getAcquisitionPaths(COLLECTION)}/${entry.id}/`;
---

<AcquisitionLayout entry={entry} path={path}>
  <Content />
</AcquisitionLayout>
