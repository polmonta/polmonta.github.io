---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Evidence from '../components/home/Evidence.astro';
import Features from '../components/home/Features.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import site from '../data/site.json';
import reviews from '../data/evidence/app-store-reviews.json';
import testimonials from '../data/evidence/customer-testimonials.json';
import claims from '../data/evidence/product-claims.json';
import screenshots from '../data/evidence/screenshots.json';
import { selectVerifiedEvidence } from '../lib/evidence.js';
import { buildOrganizationSchema, buildSoftwareApplicationSchema } from '../lib/schema.js';
import { validateBaselineData } from '../../scripts/seo/validate-baseline-data.mjs';

const pageMeta = {
  title: 'Property Management App for Small Landlords | ManageState',
  description: 'Track rental income, expenses, documents, and property performance in one straightforward iPhone app for independent landlords.',
  path: '/'
};

const baselineData = { site, reviews, testimonials, claims, screenshots };
const verifiedEvidence = selectVerifiedEvidence(
  { reviews, testimonials, claims, screenshots },
  validateBaselineData(baselineData)
);
const hasEvidence = Object.values(verifiedEvidence).some((collection) => collection.length > 0);
const schemas = [
  buildOrganizationSchema(),
  buildSoftwareApplicationSchema({ reviews: verifiedEvidence.reviews })
];
---

<BaseLayout {...pageMeta} schemas={schemas}>
  <Header slot="header" showEvidence={hasEvidence} />

  <Hero />

  {hasEvidence && <Evidence {...verifiedEvidence} />}

  <Features claims={verifiedEvidence.claims} />

  <Faq claims={verifiedEvidence.claims} />

  <FinalCta />

  <Footer slot="footer" />
</BaseLayout>
