---
import site from '../data/site.json';
import { buildAppStoreUrl } from '../lib/app-store.js';

const {
  campaign = 'website-home',
  placement,
  cluster = 'home',
  language = site.primaryLanguage,
  pagePath = Astro.url.pathname,
  class: className,
  label = 'Download ManageState for iPhone',
  ariaLabel
} = Astro.props;

const href = buildAppStoreUrl(campaign, import.meta.env.PUBLIC_APPLE_PROVIDER_TOKEN);
---

<a
  class={className}
  href={href}
  target="_blank"
  rel="noreferrer"
  aria-label={ariaLabel ?? label}
  data-app-store-click
  data-page-path={pagePath}
  data-content-cluster={cluster}
  data-cta-placement={placement}
  data-language={language}
  data-campaign={campaign}
>
  <slot>{label}</slot>
</a>
