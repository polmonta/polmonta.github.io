---
import { COLLECTION_LABELS } from '../../lib/acquisition.js';

const { cluster, title } = Astro.props;
const collectionLabel = COLLECTION_LABELS[cluster] ?? cluster;
---

<nav class="breadcrumbs breadcrumbs--legacy" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="/">Home</a>
    </li>
    <li class="breadcrumbs__item">
      <span class="breadcrumbs__section">{collectionLabel}</span>
    </li>
    <li class="breadcrumbs__item">
      <span class="breadcrumbs__section" aria-current="page">{title}</span>
    </li>
  </ol>
</nav>

<style>
  .breadcrumbs {
    color: #64748b;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumbs__item + .breadcrumbs__item::before {
    color: #94a3b8;
    content: "/";
  }

  .breadcrumbs__link {
    color: #1d4ed8;
    text-decoration: none;
  }

  .breadcrumbs__link:hover,
  .breadcrumbs__link:focus-visible {
    color: #172033;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .breadcrumbs__section {
    color: #475569;
  }
</style>
