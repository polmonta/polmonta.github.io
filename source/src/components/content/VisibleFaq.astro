---
const { faqs = [] } = Astro.props;
---

{
  faqs.length > 0 ? (
    <section class="visible-faq" aria-labelledby="visible-faq-title">
      <h2 id="visible-faq-title">Frequently asked questions</h2>
      <div class="visible-faq__grid">
        {faqs.map((faq) => (
          <article class="visible-faq__item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </section>
  ) : null
}

<style>
  .visible-faq {
    margin-top: 3rem;
  }

  .visible-faq h2 {
    color: #172033;
    font-size: 1.5rem;
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .visible-faq__grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .visible-faq__item {
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    background: #ffffff;
    box-shadow: 0 0.75rem 2rem rgba(51, 65, 85, 0.05);
    padding: 1.5rem;
  }

  .visible-faq__item h3 {
    color: #172033;
    font-size: 1.05rem;
    font-weight: 680;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .visible-faq__item p {
    margin-top: 0.6rem;
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.65;
  }
</style>
