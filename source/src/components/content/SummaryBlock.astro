---
const { summary = [] } = Astro.props;
---

<section class="summary-block" aria-labelledby="summary-title">
  <h2 id="summary-title">At a glance</h2>
  <ul class="summary-block__list">
    {summary.map((item) => (
      <li class="summary-block__item">{item}</li>
    ))}
  </ul>
</section>

<style>
  .summary-block {
    margin-top: 2.5rem;
  }

  .summary-block h2 {
    color: #172033;
    font-size: 1.25rem;
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .summary-block__list {
    display: grid;
    gap: 0.75rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .summary-block__item {
    border: 1px solid #dbeafe;
    border-left: 3px solid #3b82f6;
    border-radius: 0 0.75rem 0.75rem 0;
    background: #f8fbff;
    padding: 0.85rem 1rem;
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
