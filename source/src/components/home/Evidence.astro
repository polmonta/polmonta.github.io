---
import AppStoreLink from '../AppStoreLink.astro';

const claims = Array.isArray(Astro.props.claims) ? Astro.props.claims : [];
const reviews = Array.isArray(Astro.props.reviews) ? Astro.props.reviews : [];
const testimonials = Array.isArray(Astro.props.testimonials) ? Astro.props.testimonials : [];
const screenshots = Array.isArray(Astro.props.screenshots) ? Astro.props.screenshots : [];
const hasEvidence = [claims, reviews, testimonials, screenshots].some((collection) => collection.length > 0);

function browserAssetPath(assetPath) {
  if (typeof assetPath !== 'string') {
    return '';
  }

  return assetPath.replace(/^landing-page\/public/, '') || assetPath;
}
---

{hasEvidence && (
  <section id="evidence" class="section section--evidence" aria-labelledby="evidence-title">
    <div class="site-container">
      <div class="section-header section-header--compact">
        <p class="eyebrow">Verified product evidence</p>
        <h2 id="evidence-title">What ManageState can do today.</h2>
        <p>
          The details below are limited to product behavior and public feedback that have been checked against their source records.
        </p>
      </div>

      {claims.length > 0 && (
        <div class="evidence-grid" aria-label="Verified product capabilities">
          {claims.map((claim) => (
            <article class="evidence-card">
              <span class="evidence-card__marker" aria-hidden="true">✓</span>
              <p>{claim.text}</p>
            </article>
          ))}
        </div>
      )}

      {reviews.length > 0 && (
        <div class="evidence-reviews">
          {reviews.map((review) => (
            <figure class="review-card">
              <blockquote>“{review.quote}”</blockquote>
              <figcaption>
                <span>{review.author ?? 'App Store reviewer'}</span>
                <a href={review.sourceUrl} target="_blank" rel="noreferrer">Read the App Store review</a>
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      {testimonials.length > 0 && (
        <div class="evidence-reviews">
          {testimonials.map((testimonial) => (
            <figure class="review-card">
              <blockquote>“{testimonial.quote}”</blockquote>
              <figcaption>{testimonial.displayName ?? testimonial.displayIdentity}</figcaption>
            </figure>
          ))}
        </div>
      )}

      {screenshots.length > 0 && (
        <div class="evidence-screenshots">
          {screenshots.map((screenshot) => (
            <figure class="evidence-screenshot">
              <img src={browserAssetPath(screenshot.assetPath ?? screenshot.publicAssetPath ?? screenshot.path)} alt={screenshot.altText ?? screenshot.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      )}

      <div class="hero__actions">
        <AppStoreLink
          class="button button--primary button--large"
          campaign="website-home"
          placement="evidence"
          cluster="home"
          language="en"
        >
          Download ManageState for iPhone
        </AppStoreLink>
      </div>
    </div>
  </section>
)}
