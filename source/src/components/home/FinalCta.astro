---
import AppStoreLink from '../AppStoreLink.astro';
---

<section class="section section--final-cta" aria-labelledby="final-cta-title">
  <div class="site-container">
    <div class="final-cta">
      <p class="eyebrow">Make the next rental review easier</p>
      <h2 id="final-cta-title">Bring your property records together.</h2>
      <p>
        Track rental income, expenses, documents, and property performance from one focused iPhone app for independent landlords.
      </p>
      <div class="final-cta__actions">
        <AppStoreLink
          class="button button--primary button--large"
          campaign="website-home"
          placement="final"
          cluster="home"
          language="en"
        >
          Download ManageState for iPhone
        </AppStoreLink>
        <a class="button button--ghost button--large" href="#faq">Read the FAQs</a>
      </div>
    </div>
  </div>
</section>
