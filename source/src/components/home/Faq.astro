---
import site from '../../data/site.json';
import { buildWorkflowFaqAnswer } from '../../lib/evidence.js';

const workflowAnswer = buildWorkflowFaqAnswer(Astro.props.claims);
---

<section id="faq" class="section section--faq" aria-labelledby="faq-title">
  <div class="site-container">
    <div class="section-header section-header--compact">
      <p class="eyebrow">Questions, answered plainly</p>
      <h2 id="faq-title">Frequently asked questions.</h2>
      <p>Clear answers about the audience, workflows, and links that are available today.</p>
    </div>

    <div class="faq-grid">
      <article class="faq-card">
        <h3>Who does ManageState serve?</h3>
        <p>
          ManageState is for independent landlords who want a straightforward iPhone app for rental income, expenses, documents, and property performance.
        </p>
      </article>

      <article class="faq-card">
        <h3>Is a payment card required?</h3>
        <p>
          The current verified product evidence does not confirm whether a payment card is required, so we do not make a card or plan claim here. Check the
          <a href={site.appStoreBaseUrl} target="_blank" rel="noreferrer">App Store listing</a>
          (informational, not a measured CTA) for current availability details.
        </p>
      </article>

      <article class="faq-card">
        <h3>Which financial and document workflows are supported?</h3>
        {workflowAnswer ? (
          <p>{workflowAnswer}</p>
        ) : (
          <p>Detailed workflow information is not included until the relevant product evidence has been validated.</p>
        )}
      </article>

      <article class="faq-card">
        <h3>Where can I find data and privacy details?</h3>
        <p>
          Read the
          <a href="/privacy/">Privacy Policy</a>
          and
          <a href="/terms/">Terms</a>
          for the authoritative data and privacy information. This page does not add unverified security claims.
        </p>
      </article>
    </div>
  </div>
</section>
