---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import AppStoreLink from '../components/AppStoreLink.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import SummaryBlock from '../components/content/SummaryBlock.astro';
import VisibleFaq from '../components/content/VisibleFaq.astro';
import RelatedContent from '../components/content/RelatedContent.astro';
import { buildArticleSchema, buildBreadcrumbListSchema } from '../lib/schema.js';
import { COLLECTION_LABELS } from '../lib/acquisition.js';
import { buildAppStoreUrl } from '../lib/app-store.js';

const { entry, path } = Astro.props;
const { data } = entry;

const isGuide = data.cluster === 'guides';

// Every nested acquisition page emits a BreadcrumbList schema matching the
// visible breadcrumb (home, collection section, current page; design §7).
// Guides are additionally Article-eligible: emit Article schema with the
// visible updated date and the organization as author. FAQ schema is
// intentionally omitted (see docs/seo/editorial-review.md), so only the
// visible FAQ remains.
const schemas = [
  buildBreadcrumbListSchema({
    path,
    title: data.h1,
    section: COLLECTION_LABELS[data.cluster] ?? data.cluster
  }),
  ...(isGuide
    ? [
        buildArticleSchema({
          headline: data.h1,
          description: data.description,
          date: data.updatedAt,
          path,
          image: '/social/managestate-og.png'
        })
      ]
    : [])
];

const pageMeta = {
  title: data.title,
  description: data.description,
  path,
  schemas
};
const appStoreUrl = buildAppStoreUrl('website-home', import.meta.env.PUBLIC_APPLE_PROVIDER_TOKEN);

const updatedLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(data.updatedAt);
---

<BaseLayout {...pageMeta}>
  <Navbar slot="header" client:load appStoreUrl={appStoreUrl} pagePath={path} />

  <article class="acquisition-article acquisition-article--legacy">
    <div class="site-container acquisition-article__inner">
      <Breadcrumbs cluster={data.cluster} title={data.h1} />

      <h1 class="acquisition-article__title">{data.h1}</h1>

      {isGuide && (
        <p class="acquisition-article__updated">Last updated {updatedLabel}</p>
      )}

      <p class="acquisition-article__opening">{data.openingAnswer}</p>

      <SummaryBlock summary={data.summary} />

      <div class="acquisition-article__body">
        <slot />
      </div>

      <VisibleFaq faqs={data.faqs} />

      <RelatedContent related={data.related} />

      <AppStoreLink
        class="button button--primary button--large acquisition-article__cta"
        campaign={data.campaign}
        cluster={data.cluster}
        placement="content"
        language={data.lang}
        pagePath={path}
      >
        Download ManageState for iPhone
      </AppStoreLink>
    </div>
  </article>

  <Footer slot="footer" client:load appStoreUrl={appStoreUrl} pagePath={path} />
</BaseLayout>

<style>
  .acquisition-article {
    padding: 8rem 0 6rem;
    background:
      radial-gradient(circle at 92% 2%, rgba(233, 213, 255, 0.38), transparent 24rem),
      #ffffff;
  }

  .acquisition-article__inner {
    max-width: 46rem;
  }

  .acquisition-article__title {
    margin-top: 1.5rem;
    color: #172033;
    font-size: clamp(2rem, 4.5vw, 3.35rem);
    font-weight: 730;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .acquisition-article__opening {
    margin-top: 1.25rem;
    color: #526176;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .acquisition-article__updated {
    margin-top: 1rem;
    color: #64748b;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .acquisition-article__body {
    margin-top: 2.5rem;
    color: #475569;
    font-size: 1rem;
    line-height: 1.7;
  }

  .acquisition-article__body h2 {
    margin-top: 2.25rem;
    color: #172033;
    font-size: 1.5rem;
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .acquisition-article__body h3 {
    margin-top: 1.5rem;
    color: #334155;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .acquisition-article__body p,
  .acquisition-article__body ul,
  .acquisition-article__body ol {
    margin-top: 1rem;
  }

  .acquisition-article__body ul,
  .acquisition-article__body ol {
    padding-left: 1.5rem;
  }

  .acquisition-article__body li + li {
    margin-top: 0.5rem;
  }

  .acquisition-article__body a {
    color: #1d4ed8;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .acquisition-article__cta {
    margin-top: 3rem;
  }
</style>
